# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://sgi:sgi@localhost:5432/sgi"

# Obligatorio: cadena larga y aleatoria. Generar con: openssl rand -hex 32
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

PORT=4000
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
# Carpeta donde se guardan los respaldos (PDF / imágenes)
UPLOAD_DIR="./uploads"
# Zona horaria para la fecha de las boletas
APP_TZ="America/La_Paz"
# Solo si el frontend NO usa el proxy /api de Next (otro origen)
# CORS_ORIGIN="http://localhost:3000"

# Contraseña inicial de los usuarios creados por el seed
SEED_PASSWORD="Cambiar123!"

# true: TypeORM crea/ajusta las tablas al arrancar (cómodo en desarrollo).
# En producción ponlo en false y usa migraciones.
DB_SYNCHRONIZE=true
